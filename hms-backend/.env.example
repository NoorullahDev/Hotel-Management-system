# ------------------------------------------------------------------
# Hotel Management System - Backend Environment Variables
# Copy this file to .env and fill in real values.
# Never commit real secrets.
# ------------------------------------------------------------------

# Database connection (SQLite via the better-sqlite3 adapter).
# Relative paths resolve from the backend working directory (hms-backend).
# Use the gitignored dev.local.db for local development so the committed
# prisma/dev.db (shipped with the installer) is never modified locally.
DATABASE_URL="file:./prisma/dev.local.db"

# JWT secrets. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# JWT_REFRESH_SECRET must be a DIFFERENT value from JWT_SECRET.
JWT_SECRET="generate-a-random-64-char-hex-string"
JWT_REFRESH_SECRET="generate-a-different-random-64-char-hex-string"

# Frontend origin for CORS / Socket.IO.
FRONTEND_URL="http://127.0.0.1:4000"

# Port the backend listens on.
PORT=4000

# ------------------------------------------------------------------
# License system
# ------------------------------------------------------------------

# Master secret used to encrypt/decrypt license keys (AES-256-CBC). It must
# match the secret used by generate-license.js and, in packaged builds,
# hms-desktop/secrets.env. The backend REFUSES to start if this is missing.
# Generate with the same node one-liner as above.
LICENSE_SECRET="generate-a-random-64-char-hex-string"

# ------------------------------------------------------------------
# Optional
# ------------------------------------------------------------------

# Key that authorizes the automatic on-close backup endpoint. The Electron
# shell (hms-desktop/main.js) generates this per launch and sends it in the
# x-auto-backup-key header. Leave empty for direct server usage.
AUTO_BACKUP_KEY=""

# Directory for automatic backups (default: ~/Desktop/Backup).
BACKUP_DIR=""

# Directory for uploaded images (default: ./uploads).
UPLOADS_DIR=""
