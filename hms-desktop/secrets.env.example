# Product-wide license encryption secret.
#
# 1. Copy this file to secrets.env and set a random 64-char hex value:
#      node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 2. Put the SAME value in hms-backend/.env as LICENSE_SECRET — this is what
#    generate-license.js uses to create license keys.
# 3. secrets.env is packaged into the installer (extraResources) and read by
#    main.js, so every installed copy uses the same secret and can validate
#    the keys you generate.
#
# Keep secrets.env OUT of version control (it is gitignored). Builds fail if
# it is missing, so an installation can never be built with a broken license.
LICENSE_SECRET=generate-a-random-64-char-hex-string
