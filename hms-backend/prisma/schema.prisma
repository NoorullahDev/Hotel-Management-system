generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Role {
  id          String @id @default(uuid())
  name        String @unique
  permissions Json   @default("[]")
  users       User[]
}

model User {
  id                     String                  @id @default(uuid())
  username               String                  @unique
  email                  String                  @unique
  passwordHash           String
  name                   String
  phone                  String?
  profilePhoto           String?
  roleId                 String
  oauthProvider          String?
  failedLoginAttempts    Int                     @default(0)
  lockedUntil            DateTime?
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  mustChangePassword     Boolean                 @default(true)
  staff                  Staff?
  role                   Role                    @relation(fields: [roleId], references: [id])
}

model Staff {
  id                String             @id @default(uuid())
  userId            String             @unique
  employeeId        String?            @unique @default(uuid())
  role              String?            @default("Staff")
  department        String
  shift             String?
  attendance        Float?             @default(100.0)
  hireDate          DateTime
  status            String
  housekeepingTasks HousekeepingTask[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Guest {
  id          String    @id @default(uuid())
  guestType   String    @default("LOCAL")
  name        String
  email       String?   @unique
  phone       String?
  idType      String?
  idNumber    String?
  nationality String?
  city        String?
  country     String?
  address     String?
  notes       String?
  bookings    Booking[]

  @@index([name])
  @@index([guestType])
  @@index([phone])
  @@index([nationality])
}

model RoomType {
  id    String @id @default(uuid())
  name  String
  rooms Room[]
}

model Room {
  id                String             @id @default(uuid())
  number            String             @unique
  floor             Int
  roomTypeId        String
  price             Decimal
  status            RoomStatus         @default(AVAILABLE)
  amenities         String             @default("[]")
  imageUrl          String?
  bookings          Booking[]
  housekeepingTasks HousekeepingTask[]
  roomType          RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  roomMaintenances  RoomMaintenance[]
}

model Booking {
  id               String        @id @default(uuid())
  bookingType      String        @default("LOCAL")
  guestId          String
  roomId           String
  checkIn          DateTime
  checkOut         DateTime
  arrivalTime      DateTime?
  guestCount       Int
  additionalGuests Json?
  status           BookingStatus @default(CONFIRMED)
  subtotal         Decimal
  tax              Decimal
  total            Decimal
  createdAt        DateTime      @default(now())
  room             Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guest            Guest         @relation(fields: [guestId], references: [id], onDelete: Cascade)
  feedback         Feedback?
  foodOrders       FoodOrder[]
  invoice          Invoice?
  payments         Payment[]

  @@index([createdAt])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([guestId])
  @@index([roomId])
  @@index([bookingType])
  @@index([bookingType, status])
  @@index([status, checkIn])
  @@index([createdAt, status])
}

model Payment {
  id        String   @id @default(uuid())
  bookingId String
  amount    Decimal
  method    String
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([bookingId])
  @@index([method])
  @@index([createdAt, method])
}

model Invoice {
  id        String        @id @default(uuid())
  bookingId String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items     InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  amount      Decimal
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model FoodOrder {
  id          String      @id @default(uuid())
  orderNumber String      @unique @default(uuid())
  bookingId   String
  status      String
  totalAmount Decimal     @default(0)
  notes       String?
  createdAt   DateTime    @default(now())
  acceptedAt  DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items       OrderItem[]

  @@index([createdAt])
  @@index([status])
  @@index([bookingId])
  @@index([createdAt, status])
}

model OrderItem {
  id          String    @id @default(uuid())
  foodOrderId String
  itemName    String
  quantity    Int
  price       Decimal
  foodOrder   FoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
}

model MenuCategory {
  id   String @id @default(uuid())
  name String @unique
}

model MenuItem {
  id          String  @id @default(uuid())
  name        String
  category    String
  price       Decimal
  imageUrl    String?
  isAvailable Boolean @default(true)
}

model HousekeepingTask {
  id            String    @id @default(uuid())
  roomId        String?
  area          String?
  staffId       String?
  status        String    @default("PENDING")
  priority      String    @default("Medium")
  taskType      String    @default("Cleaning")
  estimatedTime Int       @default(30)
  scheduledDate DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  inspectedAt   DateTime?
  staff         Staff?    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  room          Room?     @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([scheduledDate])
  @@index([status, scheduledDate])
}

model RoomMaintenance {
  id          String @id @default(uuid())
  roomId      String
  description String
  status      String
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String  @id @default(uuid())
  bookingId String  @unique
  rating    Int
  comment   String?
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String   @default("System")
  title       String   @default("Notification")
  message     String
  referenceId String?
  metadata    Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id          String  @id @default(uuid())
  userId      String  @unique
  booking     Boolean @default(true)
  checkIn     Boolean @default(true)
  checkOut    Boolean @default(true)
  roomReady   Boolean @default(true)
  foodOrder   Boolean @default(true)
  feedback    Boolean @default(true)
  system      Boolean @default(true)
  payment     Boolean @default(true)
  maintenance Boolean @default(true)
  staff       Boolean @default(true)
  emergency   Boolean @default(true)
  email       Boolean @default(true)
  sms         Boolean @default(false)
  desktop     Boolean @default(true)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String   @default("General")
  details   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
  @@index([module])
  @@index([module, createdAt])
}

model HotelSettings {
  id                   String  @id @default(uuid())
  name                 String
  taxRate              Decimal
  currency             String
  defaultCheckIn       String
  defaultCheckOut      String
  loginBackgroundImage String?
}

model Setting {
  key      String @id
  category String
  value    Json
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

model License {
  id             String   @id @default(uuid())
  hwid           String   @unique
  licenseKey     String   @unique
  status         String   @default("Active")
  activationDate DateTime @default(now())
  expiryDate     DateTime
  lastRenewed    DateTime @default(now())
}
