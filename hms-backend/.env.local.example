# Local Development Database Configuration
# Copy this file to .env.local or override your DATABASE_URL in .env
# 
# Use dev.local.db for daily debugging and running scratch scripts.
# Do NOT use prisma/dev.db for local debugging, as it is committed to version
# control and shipped with the installer.
#
# In development the backend also needs the JWT secrets and LICENSE_SECRET
# from .env, and the license system stays in DEV-MODE (always Active).

DATABASE_URL="file:./prisma/dev.local.db"
